import java.util.Scanner;

class Banking
{
    public int deposit(int dep)
    {
        return dep;
    }

    public int withdraw(int wd, int bal) throws Exception
    {
        if(wd > bal)
        {
            throw new Exception("Insufficient Balance");
        }
        return bal - wd;
    }

    public int balance(int bal)
    {
        return bal;
    }
}

class Bank
{
    public static void main(String args[])
    {
        Banking ba = new Banking();
        Scanner sc = new Scanner(System.in);

        System.out.println("Account Holder Name");
        String name = sc.nextLine();

        System.out.println("Account Number");
        int no = sc.nextInt();

        System.out.println("Initial Balance");
        int bal = sc.nextInt();

        System.out.println("Enter your choice");
        System.out.println("1. Deposit Operation");
        System.out.println("2. Withdraw Operation");
        int choice = sc.nextInt();

        try
        {
            if(choice == 1)
            {
                System.out.println("Deposit Amount");
                int deposit = sc.nextInt();

                bal = bal + ba.deposit(deposit);

                System.out.println("Amount Deposited Successfully");
                System.out.println("Available Balance: Rs. " + ba.balance(bal));
            }
            else if(choice == 2)
            {
                System.out.println("Withdraw Amount");
                int withdraw = sc.nextInt();

                bal = ba.withdraw(withdraw, bal);

                System.out.println("Amount Withdrawn Successfully");
                System.out.println("Available Balance: Rs. " + ba.balance(bal));
            }
            else
            {
                System.out.println("Invalid Choice");
            }
        }
        catch(Exception e)
        {
            System.out.println("Exception: " + e.getMessage());
            System.out.println("Transaction Failed");
            System.out.println("Available Balance: Rs. " + ba.balance(bal));
        }

        sc.close();
    }
}